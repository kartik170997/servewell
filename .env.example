APP_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CLAUDE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=folio
CLAUDE_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=multilingual-e5-large
RERANK_MODEL=bge-reranker-v2-m3

VITE_APP_TOKEN=
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=folio-workflows
MLFLOW_HTTP_REQUEST_TIMEOUT=5
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=false
MLFLOW_DISABLE_TELEMETRY=true
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true

# Anthropic procedure prefix cache (5m or 1h)
PROCEDURE_CACHE_TTL=1h

# Default frontend connection; previously saved URL takes priority
VITE_BACKEND_URL=http://localhost:8000

# Provider limits and final retrieval score cutoffs
CLAUDE_SUMMARY_MAX_TOKENS=2200
CLAUDE_HYDE_MAX_TOKENS=600
CLAUDE_WORKFLOW_MAX_TOKENS=15000
CLAUDE_LEGACY_MAX_TOKENS=2200
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_ATTEMPTS=3
WORKFLOW_MODEL_MAX_RETRIES=1
RETRIEVAL_VECTOR_MIN_SCORE=0.5
RETRIEVAL_RERANK_MIN_SCORE=0.3
RETRIEVAL_BM25_MIN_SCORE=0
RETRIEVAL_RRF_MIN_SCORE=0.01
WORKFLOW_RETRIEVAL_TOP_K=5
WORKFLOW_RETRIEVAL_CANDIDATES=30
WORKFLOW_RETRIEVAL_RERANK=false
